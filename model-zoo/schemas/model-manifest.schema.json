{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-atc.local/schemas/model-manifest-1.0.json",
  "title": "Portable ATC local model-zoo manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "models"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "identity", "category", "intended_role", "format", "quantisation", "source", "acquisition", "licence", "runtime_compatibility", "lifecycle", "assets"],
      "properties": {
        "entry_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "identity": { "$ref": "#/$defs/identity" },
        "category": { "enum": ["ASR", "LLM", "TTS", "OTHER_LOCAL_AI"] },
        "intended_role": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "quantisation": { "type": ["string", "null"], "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "acquisition": { "$ref": "#/$defs/acquisition" },
        "licence": { "$ref": "#/$defs/licence" },
        "runtime_compatibility": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "name", "revision", "variant"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "original_uri"],
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "original_uri": { "type": "string", "minLength": 1 }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquired_on", "method", "notes"],
      "properties": {
        "acquired_on": { "type": "string", "format": "date" },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spdx_id", "reference_uri", "usage_notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spdx_id": { "type": ["string", "null"] },
        "reference_uri": { "type": "string", "minLength": 1 },
        "usage_notes": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "benchmarked", "approved_for_runtime"],
      "properties": {
        "available": { "type": "boolean" },
        "benchmarked": { "type": "boolean" },
        "approved_for_runtime": { "type": "boolean" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
