{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-atc.local/schemas/benchmark-definition-1.0.json",
  "title": "Portable ATC model benchmark definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "name",
    "category",
    "purpose",
    "evaluation_set",
    "metrics",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "benchmark_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "ASR",
        "LLM",
        "TTS",
        "VISION",
        "EMBEDDING",
        "RERANKING",
        "SAFETY",
        "MULTIMODAL",
        "OTHER_LOCAL_AI"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_set": {
      "$ref": "#/$defs/evaluation_set"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/acceptance_criterion"
      }
    }
  },
  "$defs": {
    "evaluation_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "description",
        "unit",
        "direction"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better",
            "informational"
          ]
        }
      }
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "operator",
        "threshold"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte",
            "eq"
          ]
        },
        "threshold": {
          "type": "number"
        }
      }
    }
  }
}
