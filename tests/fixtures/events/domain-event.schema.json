{
  "$defs": {
    "EventActor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "system",
            "controller",
            "instructor",
            "adapter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EventActor",
      "type": "object"
    },
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Component",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "session.created",
        "session.initialising",
        "session.ready",
        "session.started",
        "session.paused",
        "session.resumed",
        "session.completed",
        "session.stopped",
        "session.failed",
        "scenario.loaded",
        "scenario.phase_changed",
        "scenario.objective_updated",
        "scenario.event_triggered",
        "controller.ptt_started",
        "controller.ptt_stopped",
        "audio.received",
        "transcript.created",
        "transcript.failed",
        "command.extracted",
        "command.accepted",
        "command.rejected",
        "command.clarification_required",
        "command.dispatched",
        "clearance.issued",
        "clearance.readback_received",
        "clearance.readback_incorrect",
        "clearance.corrected",
        "clearance.acknowledged",
        "instructor.marker_added",
        "instructor.override_applied",
        "radio.transmission_queued",
        "radio.transmission_started",
        "radio.transmission_finished",
        "radio.transmission_blocked",
        "aircraft.spawned",
        "aircraft.state_changed",
        "aircraft.route_assigned",
        "runway.occupancy_changed",
        "simulation.snapshot_created",
        "simulation.timing_anomaly",
        "competency.observation_detected",
        "competency.observation_resolved",
        "score.updated",
        "debrief.generated",
        "component.health_changed",
        "adapter.timeout",
        "adapter.failed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "SessionCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Version",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "versions": {
          "$ref": "#/$defs/SessionVersions"
        },
        "state": {
          "const": "CREATED",
          "default": "CREATED",
          "title": "State",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "scenario_version",
        "seed",
        "versions"
      ],
      "title": "SessionCreatedPayload",
      "type": "object"
    },
    "SessionFailure": {
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "category",
        "reason"
      ],
      "title": "SessionFailure",
      "type": "object"
    },
    "SessionLifecycleState": {
      "enum": [
        "CREATED",
        "INITIALISING",
        "READY",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "STOPPED",
        "FAILED"
      ],
      "title": "SessionLifecycleState",
      "type": "string"
    },
    "SessionOutcome": {
      "description": "Termination disposition, not a training score or competency assessment.",
      "enum": [
        "COMPLETED",
        "STOPPED",
        "FAILED"
      ],
      "title": "SessionOutcome",
      "type": "string"
    },
    "SessionTransitionPayload": {
      "additionalProperties": false,
      "properties": {
        "previous_state": {
          "$ref": "#/$defs/SessionLifecycleState"
        },
        "state": {
          "$ref": "#/$defs/SessionLifecycleState"
        },
        "previous_version": {
          "minimum": 1,
          "title": "Previous Version",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "previous_state",
        "state",
        "previous_version",
        "version"
      ],
      "title": "SessionTransitionPayload",
      "type": "object"
    },
    "SessionVersions": {
      "properties": {
        "configuration_version": {
          "title": "Configuration Version",
          "type": "string"
        },
        "configuration_hash": {
          "title": "Configuration Hash",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "adapters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionReference"
          },
          "title": "Adapters",
          "type": "array"
        },
        "models": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionReference"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "configuration_version",
        "configuration_hash",
        "rule_version",
        "schema_version"
      ],
      "title": "SessionVersions",
      "type": "object"
    },
    "VersionReference": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VersionReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Session Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "sim_time": {
      "minimum": 0,
      "title": "Sim Time",
      "type": "number"
    },
    "wall_time_utc": {
      "format": "date-time",
      "title": "Wall Time Utc",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/EventActor"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "correlation_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionCreatedPayload"
        },
        {
          "$ref": "#/$defs/SessionTransitionPayload"
        }
      ],
      "title": "Payload"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "session_id",
    "sequence",
    "sim_time",
    "wall_time_utc",
    "actor",
    "source",
    "correlation_id",
    "payload"
  ],
  "title": "DomainEvent",
  "type": "object"
}
