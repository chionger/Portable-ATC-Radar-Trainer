{
  "$defs": {
    "Aerodrome": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "runways": {
          "items": {
            "$ref": "#/$defs/RunwayState"
          },
          "title": "Runways",
          "type": "array"
        }
      },
      "required": [
        "geometry",
        "runways"
      ],
      "title": "Aerodrome",
      "type": "object"
    },
    "Aircraft": {
      "additionalProperties": false,
      "properties": {
        "aircraft_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Aircraft Id",
          "type": "string"
        },
        "callsign": {
          "pattern": "^[A-Z0-9][A-Z0-9 -]{0,31}$",
          "title": "Callsign",
          "type": "string"
        },
        "aircraft_type": {
          "default": "GENERIC",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Aircraft Type",
          "type": "string"
        },
        "wake_category": {
          "anyOf": [
            {
              "enum": [
                "LIGHT",
                "MEDIUM",
                "HEAVY",
                "SUPER"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wake Category"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "heading_deg": {
          "default": 0.0,
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Heading Deg",
          "type": "number"
        },
        "ground_speed_kt": {
          "default": 0.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Ground Speed Kt",
          "type": "number"
        },
        "altitude_ft": {
          "default": 0.0,
          "maximum": 100000,
          "minimum": -2000,
          "title": "Altitude Ft",
          "type": "number"
        },
        "state": {
          "$ref": "#/$defs/AircraftState"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "route": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
            "type": "string"
          },
          "title": "Route",
          "type": "array"
        },
        "route_progress": {
          "default": 0,
          "minimum": 0,
          "title": "Route Progress",
          "type": "integer"
        },
        "assigned_runway_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned Runway Id"
        },
        "holding_point_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holding Point Id"
        },
        "occupied_runway_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupied Runway Id"
        },
        "clearance_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clearance Id"
        },
        "clearance_state": {
          "default": "NONE",
          "enum": [
            "NONE",
            "ACTIVE",
            "CANCELLED"
          ],
          "title": "Clearance State",
          "type": "string"
        },
        "pilot_profile": {
          "default": "default",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Pilot Profile",
          "type": "string"
        },
        "response_state": {
          "default": "IDLE",
          "enum": [
            "IDLE",
            "PENDING",
            "RESPONDING"
          ],
          "title": "Response State",
          "type": "string"
        }
      },
      "required": [
        "aircraft_id",
        "callsign",
        "position",
        "state"
      ],
      "title": "Aircraft",
      "type": "object"
    },
    "AircraftRouteAssignedPayload": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "$ref": "#/$defs/Aircraft"
        },
        "after": {
          "$ref": "#/$defs/Aircraft"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "AircraftRouteAssignedPayload",
      "type": "object"
    },
    "AircraftSpawnedPayload": {
      "additionalProperties": false,
      "properties": {
        "aircraft": {
          "$ref": "#/$defs/Aircraft"
        },
        "aerodrome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Aerodrome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "aircraft"
      ],
      "title": "AircraftSpawnedPayload",
      "type": "object"
    },
    "AircraftState": {
      "enum": [
        "PARKED",
        "READY_TO_TAXI",
        "TAXIING",
        "HOLDING",
        "LINED_UP",
        "TAKEOFF_ROLL",
        "AIRBORNE",
        "INBOUND",
        "FINAL",
        "LANDING_ROLL",
        "VACATING",
        "STOPPED"
      ],
      "title": "AircraftState",
      "type": "string"
    },
    "AircraftStateChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "$ref": "#/$defs/Aircraft"
        },
        "after": {
          "$ref": "#/$defs/Aircraft"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "AircraftStateChangedPayload",
      "type": "object"
    },
    "ComponentHealth": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Component",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "severity": {
          "$ref": "#/$defs/HealthSeverity"
        },
        "reason": {
          "$ref": "#/$defs/HealthReason"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "component",
        "required",
        "status",
        "severity",
        "reason",
        "observed_at"
      ],
      "title": "ComponentHealth",
      "type": "object"
    },
    "ComponentHealthChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "previous_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "health": {
          "$ref": "#/$defs/ComponentHealth"
        }
      },
      "required": [
        "previous_status",
        "health"
      ],
      "title": "ComponentHealthChangedPayload",
      "type": "object"
    },
    "EventActor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "system",
            "controller",
            "instructor",
            "adapter"
          ],
          "title": "Kind",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EventActor",
      "type": "object"
    },
    "EventSource": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Component",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "EventSource",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "session.created",
        "session.initialising",
        "session.ready",
        "session.started",
        "session.paused",
        "session.resumed",
        "session.completed",
        "session.stopped",
        "session.failed",
        "scenario.loaded",
        "scenario.phase_changed",
        "scenario.objective_updated",
        "scenario.event_triggered",
        "controller.ptt_started",
        "controller.ptt_stopped",
        "audio.received",
        "transcript.created",
        "transcript.failed",
        "command.extracted",
        "command.accepted",
        "command.rejected",
        "command.clarification_required",
        "command.dispatched",
        "clearance.issued",
        "clearance.readback_received",
        "clearance.readback_incorrect",
        "clearance.corrected",
        "clearance.acknowledged",
        "instructor.marker_added",
        "instructor.override_applied",
        "radio.transmission_queued",
        "radio.transmission_started",
        "radio.transmission_finished",
        "radio.transmission_blocked",
        "aircraft.spawned",
        "aircraft.state_changed",
        "aircraft.route_assigned",
        "runway.occupancy_changed",
        "simulation.snapshot_created",
        "simulation.timing_anomaly",
        "competency.observation_detected",
        "competency.observation_resolved",
        "score.updated",
        "debrief.generated",
        "component.health_changed",
        "adapter.timeout",
        "adapter.failed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "local_metres",
          "default": "local_metres",
          "title": "Coordinate System",
          "type": "string"
        },
        "runways": {
          "items": {
            "$ref": "#/$defs/Runway"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Runways",
          "type": "array"
        },
        "taxiways": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Taxiway"
          },
          "maxItems": 256,
          "title": "Taxiways",
          "type": "array"
        },
        "holding_points": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HoldingPoint"
          },
          "maxItems": 256,
          "title": "Holding Points",
          "type": "array"
        }
      },
      "required": [
        "runways"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "HealthReason": {
      "enum": [
        "operational",
        "starting",
        "failed",
        "timeout",
        "not_configured"
      ],
      "title": "HealthReason",
      "type": "string"
    },
    "HealthSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "HealthSeverity",
      "type": "string"
    },
    "HealthStatus": {
      "enum": [
        "healthy",
        "degraded",
        "unready"
      ],
      "title": "HealthStatus",
      "type": "string"
    },
    "HoldingPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "runway_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Runway Id",
          "type": "string"
        },
        "taxiway_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Taxiway Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "position",
        "runway_id",
        "taxiway_id"
      ],
      "title": "HoldingPoint",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Runway": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "threshold": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "threshold",
        "end",
        "width_m"
      ],
      "title": "Runway",
      "type": "object"
    },
    "RunwayOccupancyChangedPayload": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "$ref": "#/$defs/RunwayState"
        },
        "after": {
          "$ref": "#/$defs/RunwayState"
        },
        "aircraft_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Aircraft Id",
          "type": "string"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        }
      },
      "required": [
        "before",
        "after",
        "aircraft_id",
        "present"
      ],
      "title": "RunwayOccupancyChangedPayload",
      "type": "object"
    },
    "RunwayState": {
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "$ref": "#/$defs/Runway"
        },
        "designator": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Designator",
          "type": "string"
        },
        "operational_status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "CLOSED"
          ],
          "title": "Operational Status",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "occupants": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
            "type": "string"
          },
          "title": "Occupants",
          "type": "array"
        }
      },
      "required": [
        "geometry",
        "designator"
      ],
      "title": "RunwayState",
      "type": "object"
    },
    "SessionCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scenario Version",
          "type": "string"
        },
        "scenario_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Hash"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "versions": {
          "$ref": "#/$defs/SessionVersions"
        },
        "state": {
          "const": "CREATED",
          "default": "CREATED",
          "title": "State",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "scenario_version",
        "seed",
        "versions"
      ],
      "title": "SessionCreatedPayload",
      "type": "object"
    },
    "SessionFailure": {
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "category",
        "reason"
      ],
      "title": "SessionFailure",
      "type": "object"
    },
    "SessionLifecycleState": {
      "enum": [
        "CREATED",
        "INITIALISING",
        "READY",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "STOPPED",
        "FAILED"
      ],
      "title": "SessionLifecycleState",
      "type": "string"
    },
    "SessionOutcome": {
      "description": "Termination disposition, not a training score or competency assessment.",
      "enum": [
        "COMPLETED",
        "STOPPED",
        "FAILED"
      ],
      "title": "SessionOutcome",
      "type": "string"
    },
    "SessionTransitionPayload": {
      "additionalProperties": false,
      "properties": {
        "previous_state": {
          "$ref": "#/$defs/SessionLifecycleState"
        },
        "state": {
          "$ref": "#/$defs/SessionLifecycleState"
        },
        "previous_version": {
          "minimum": 1,
          "title": "Previous Version",
          "type": "integer"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "previous_state",
        "state",
        "previous_version",
        "version"
      ],
      "title": "SessionTransitionPayload",
      "type": "object"
    },
    "SessionVersions": {
      "properties": {
        "configuration_version": {
          "title": "Configuration Version",
          "type": "string"
        },
        "configuration_hash": {
          "title": "Configuration Hash",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "adapters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionReference"
          },
          "title": "Adapters",
          "type": "array"
        },
        "models": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionReference"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "configuration_version",
        "configuration_hash",
        "rule_version",
        "schema_version"
      ],
      "title": "SessionVersions",
      "type": "object"
    },
    "Taxiway": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 256,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "id",
        "points"
      ],
      "title": "Taxiway",
      "type": "object"
    },
    "VersionReference": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VersionReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Session Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "sim_time": {
      "minimum": 0,
      "title": "Sim Time",
      "type": "number"
    },
    "wall_time_utc": {
      "format": "date-time",
      "title": "Wall Time Utc",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/EventActor"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    },
    "correlation_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionCreatedPayload"
        },
        {
          "$ref": "#/$defs/SessionTransitionPayload"
        },
        {
          "$ref": "#/$defs/ComponentHealthChangedPayload"
        },
        {
          "$ref": "#/$defs/AircraftRouteAssignedPayload"
        },
        {
          "$ref": "#/$defs/AircraftSpawnedPayload"
        },
        {
          "$ref": "#/$defs/AircraftStateChangedPayload"
        },
        {
          "$ref": "#/$defs/RunwayOccupancyChangedPayload"
        }
      ],
      "title": "Payload"
    }
  },
  "required": [
